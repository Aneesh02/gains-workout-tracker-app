<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <!-- Header row: GAINS label + weekly count -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GAINS"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:letterSpacing="0.2"
            android:textStyle="bold"
            android:alpha="0.4" />

        <TextView
            android:id="@+id/widget_weekly_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 / 0 this week"
            android:textColor="#64B5F6"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Flexible vertical spacer using TextView -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="" />

    <!-- Stats row: streak left, volume right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Streak number -->
        <TextView
            android:id="@+id/widget_streak_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FF6B35"
            android:textSize="40sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <!-- Streak label -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WEEK"
                android:textColor="#FF6B35"
                android:textSize="9sp"
                android:textStyle="bold"
                android:alpha="0.8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STREAK"
                android:textColor="#FF6B35"
                android:textSize="9sp"
                android:textStyle="bold"
                android:alpha="0.8" />

        </LinearLayout>

        <!-- Horizontal spacer using TextView with weight -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:text="" />

        <!-- Volume block (right-aligned) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/widget_volume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#A5D6A7"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="end"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VOLUME"
                android:textColor="#A5D6A7"
                android:textSize="9sp"
                android:textStyle="bold"
                android:gravity="end"
                android:alpha="0.7" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
